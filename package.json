{
  "name": "fabcad-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/fabcad run dev",
    "build": "npm --workspace apps/fabcad run build",
    "preview": "npm --workspace apps/fabcad run preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:occt": "node scripts/audit-occt-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
